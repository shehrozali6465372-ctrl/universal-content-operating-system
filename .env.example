# ─── Production Environment ───
# Copy to .env and fill in real values

# App
APP_ENV=production
APP_PORT=8000

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=aios
POSTGRES_USER=aios
POSTGRES_PASSWORD=your-strong-password-here

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# AI Providers (add your keys)
# Live Agent 01 web research (optional; without a key discovery is blocked)
TAVILY_API_KEY=
UCOS_TAVILY_TIMEOUT_SECONDS=12
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
OPENAI_API_KEY=

# Facebook
FACEBOOK_PAGE_ID=
FACEBOOK_ACCESS_TOKEN=

# Meta System User (runtime secret; never commit the real value)
META_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v26.0
